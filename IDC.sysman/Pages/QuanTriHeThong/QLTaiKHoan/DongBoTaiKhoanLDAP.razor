@page "/admin/dong-bo-tai-khoan-ldap"
@using IDC.Frontend.Services
@inject NotificationService notificationService
@inject ClientServices client
@inject HttpClient Http
@inject Radzen.DialogService DialogService
@inject NavigationManager Navigation

@if (isLoading)
{
    <div class="text-center" style="padding: 12px 0; color: #888;">Đang tải dữ liệu...</div>
}

@* --- BẢNG KEYCLOAK USERS --- *@
<RadzenDataGrid @ref="kcGrid" Data="@keycloakUsers" TItem="KcUserDto"
                AllowSorting="true" AllowFiltering="true" AllowPaging="true" PageSize="10"
                GridLines="DataGridGridLines.Both" Style="width:100%">
    <HeaderTemplate>
        <div style="display:flex; align-items:center; width:100%; padding:8px 0; gap:8px;">
            <RadzenButton Icon="refresh" Text="Tải lại dữ liệu" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                          Click="@LoadData" Disabled="@(isLoading || isSyncing)" />
            <RadzenButton Icon="sync" Text="@($"Đồng bộ Keycloak → SQL ({selectedUsernames.Count})")"
                          ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                          Click="@SyncToSql" Disabled="@(isLoading || isSyncing || selectedUsernames.Count == 0)" />
            @if (syncResult != null)
            {
                <span style="align-self:center; padding:4px 10px; border-radius:4px; font-size:13px;
                             background-color:@(syncResultOk ? "#28a745" : "#dc3545"); color:white;">
                    @syncResult
                </span>
            }
        </div>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="KcUserDto" Width="50px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
            <HeaderTemplate>
                <input type="checkbox" @onchange="ToggleSelectAll" />
            </HeaderTemplate>
            <Template Context="row">
                @{
                    bool existsInSql = sqlUsers?.Any(s => s.UserName.Equals(row.Username, StringComparison.OrdinalIgnoreCase)) ?? false;
                }
                <input type="checkbox" disabled="@existsInSql"
                       checked="@(selectedUsernames.Contains(row.Username))"
                       @onchange="@(e => ToggleUser(row.Username, (bool)(e.Value ?? false)))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="KcUserDto" Property="Username" Title="Tên tài khoản" Width="180px" TextAlign="TextAlign.Center" Frozen="true" />
        <RadzenDataGridColumn TItem="KcUserDto" Property="Name" Title="Họ và tên" Width="200px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="KcUserDto" Property="Email" Title="Email" Width="220px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="KcUserDto" Title="Trạng thái" Width="120px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
            <Template Context="row">
                @if (row.Enabled)
                {
                    <RadzenBadge Text="Hoạt động" BadgeStyle="BadgeStyle.Success" />
                }
                else
                {
                    <RadzenBadge Text="Vô hiệu" BadgeStyle="BadgeStyle.Danger" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="KcUserDto" Title="Đã có SQL?" Width="120px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
            <Template Context="row">
                @{
                    bool existsInSql = sqlUsers?.Any(s => s.UserName.Equals(row.Username, StringComparison.OrdinalIgnoreCase)) ?? false;
                }
                @if (existsInSql)
                {
                    <RadzenBadge Text="✔ Có" BadgeStyle="BadgeStyle.Success" />
                }
                else
                {
                    <RadzenBadge Text="✘ Chưa" BadgeStyle="BadgeStyle.Warning" />
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@* --- BẢNG SQL USERS --- *@
<RadzenDataGrid Data="@sqlUsers" TItem="SqlUserDto"
                AllowSorting="true" AllowFiltering="true" AllowPaging="true" PageSize="10"
                GridLines="DataGridGridLines.Both" Style="width:100%; margin-top:20px;">
    <Columns>
        <RadzenDataGridColumn TItem="SqlUserDto" Property="IdUser" Title="ID" Width="80px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="SqlUserDto" Property="UserName" Title="Tên tài khoản" Width="180px" TextAlign="TextAlign.Center" Frozen="true" />
        <RadzenDataGridColumn TItem="SqlUserDto" Property="FullName" Title="Họ và tên" Width="220px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="SqlUserDto" Title="Source" Width="130px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
            <Template Context="row">
                @{
                    bool inKc = keycloakUsers?.Any(k => k.Username.Equals(row.UserName, StringComparison.OrdinalIgnoreCase)) ?? false;
                }
                @if (inKc)
                {
                    <RadzenBadge Text="Keycloak" BadgeStyle="BadgeStyle.Info" />
                }
                else
                {
                    <RadzenBadge Text="Cục bộ" BadgeStyle="BadgeStyle.Warning" />
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    RadzenDataGrid<KcUserDto> kcGrid;
    List<KcUserDto> keycloakUsers = new();
    List<SqlUserDto> sqlUsers = new();
    HashSet<string> selectedUsernames = new();
    bool isLoading = false;
    bool isSyncing = false;
    string? syncResult;
    bool syncResultOk = true;

    private const string ApiBaseUrl = "http://localhost:5240";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        isLoading = true;
        syncResult = null;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"{ApiBaseUrl}/api/sync/keycloak-users");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                keycloakUsers = System.Text.Json.JsonSerializer.Deserialize<List<KcUserDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                    ?? new List<KcUserDto>();
            }
            else keycloakUsers = new();
        }
        catch (Exception ex)
        {
            keycloakUsers = new();
            notificationService.Notify(NotificationSeverity.Error, "Lỗi", $"Keycloak: {ex.Message}");
        }

        try
        {
            var response = await Http.GetAsync($"{ApiBaseUrl}/api/sync/sql-users");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                sqlUsers = System.Text.Json.JsonSerializer.Deserialize<List<SqlUserDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                    ?? new List<SqlUserDto>();
            }
            else sqlUsers = new();
        }
        catch (Exception ex)
        {
            sqlUsers = new();
            notificationService.Notify(NotificationSeverity.Error, "Lỗi", $"SQL: {ex.Message}");
        }

        selectedUsernames.Clear();
        isLoading = false;
        StateHasChanged();
    }

    void ToggleSelectAll(ChangeEventArgs e)
    {
        selectedUsernames.Clear();
        if ((bool)(e.Value ?? false) && keycloakUsers != null)
        {
            foreach (var u in keycloakUsers.Where(k =>
                sqlUsers == null || !sqlUsers.Any(s => s.UserName.Equals(k.Username, StringComparison.OrdinalIgnoreCase))))
                selectedUsernames.Add(u.Username);
        }
    }

    void ToggleUser(string username, bool isChecked)
    {
        if (isChecked) selectedUsernames.Add(username); else selectedUsernames.Remove(username);
    }

    async Task SyncToSql()
    {
        var toSync = keycloakUsers.Where(k => selectedUsernames.Contains(k.Username)).ToList();
        if (toSync.Count == 0) return;

        isSyncing = true;
        syncResult = null;
        StateHasChanged();

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new { Users = toSync });
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await Http.PostAsync($"{ApiBaseUrl}/api/sync", content);

            if (response.IsSuccessStatusCode)
            {
                syncResult = $"Đồng bộ thành công {toSync.Count} user!";
                syncResultOk = true;
                notificationService.Notify(NotificationSeverity.Success, "Thành công", syncResult);
                selectedUsernames.Clear();
                await LoadData();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                syncResult = $"Lỗi: {response.StatusCode} - {body}";
                syncResultOk = false;
                notificationService.Notify(NotificationSeverity.Error, "Lỗi", syncResult);
            }
        }
        catch (Exception ex)
        {
            syncResult = $"Lỗi: {ex.Message}";
            syncResultOk = false;
        }
        finally
        {
            isSyncing = false;
            StateHasChanged();
        }
    }

    // ---- DTOs ----
    public class KcUserDto
    {
        public string Username { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public bool Enabled { get; set; }
    }

    public class SqlUserDto
    {
        public int IdUser { get; set; }
        public string UserName { get; set; } = "";
        public string FullName { get; set; } = "";
        public int? IdPhanMem { get; set; }
    }
}