@page "/login"
@layout LoginLayout
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Đăng nhập</PageTitle>

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="text-center">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">Đang chuyển hướng đến Keycloak...</p>
    </div>
</div>

@code {

    protected override void OnInitialized()
    {
        var keycloakUrl = Configuration["Keycloak:Url"] ?? "http://192.168.93.198:8080";
        var realm = Configuration["Keycloak:Realm"] ?? "TestSSO";
        var clientId = Configuration["Keycloak:ClientId"] ?? "TestSSO";
        var postLogoutRedirectUri = Configuration["Keycloak:PostLogoutRedirectUri"] ?? "http://localhost:5105/";
        var redirectUri = postLogoutRedirectUri.TrimEnd('/') + "/callback";

        var keycloakLoginUrl =
            $"{keycloakUrl}/realms/{realm}/protocol/openid-connect/auth" +
            $"?client_id={clientId}" +
            $"&response_type=code" +
            $"&scope=openid" +
            $"&redirect_uri={Uri.EscapeDataString(redirectUri)}";

        Navigation.NavigateTo(keycloakLoginUrl, true);
    }
}